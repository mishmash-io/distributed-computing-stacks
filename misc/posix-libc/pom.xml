                <mkdir dir="${project.build.directory}/generated-sources/jextract" />
                <!-- find correct path to header files -->
                <exec executable="bash" failonerror="true" discardError="true" outputproperty="headers.path">
                  <arg value="-c" />
                  <arg value="if [[ $(gcc --print-multiarch) ]]; then echo /usr/include/$(gcc --print-multiarch); else echo /usr/include; fi" />
                </exec>
                <!-- extract errno-related constants and functions -->
                <exec executable="${jextract.path}" dir="${project.build.directory}/generated-sources/jextract" failonerror="true">
