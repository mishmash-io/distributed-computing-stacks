                  <arg value="--include-constant" />
                  <arg value="EMSGSIZE" />
                  <arg value="--include-constant" />
                  <arg value="ENAMETOOLONG" />
                  <arg value="--include-constant" />
                  <arg value="ENFILE" />
                  <arg value="--include-constant" />
