                  <arg value="/usr/include" />
                  <arg value="--include-constant" />
                  <arg value="EACCES" />
                  <arg value="--include-constant" />
                  <arg value="EAGAIN" />
                  <arg value="--include-constant" />
                  <arg value="EALREADY" />
                  <arg value="--include-constant" />
                  <arg value="EBADF" />
                  <arg value="--include-constant" />
                  <arg value="EBUSY" />
                  <arg value="--include-constant" />
                  <arg value="ECONNRESET" />
                  <arg value="--include-constant" />
