                </exec>
                <!-- unistd-related headers -->
                <exec executable="${jextract.path}" dir="${project.build.directory}/generated-sources/jextract" failonerror="true">
                  <arg value="-I" />
                  <arg value="/usr/include" />
                  <arg value="--include-constant" />
                  <arg value="_SC_PAGESIZE" />
                  <arg value="--include-function" />
                  <arg value="close" />
                  <arg value="--include-function" />
                  <arg value="ftruncate" />
                  <arg value="--include-function" />
                  <arg value="sysconf" />
                  <arg value="-t" />
                  <arg value="io.mishmash.foreign.posix.linux.x86_64.libc" />
                  <arg value="--header-class-name" />
                  <arg value="UnistdH" />
                  <arg value="/usr/include/unistd.h" />
                </exec>
                <!-- shared-memory-related headers -->
                <exec executable="${jextract.path}" dir="${project.build.directory}/generated-sources/jextract" failonerror="true">
                  <arg value="-I" />
                  <arg value="${headers.path}" />
                  <arg value="--define-macro" />
