                  <arg value="SCM_RIGHTS" />
                  <arg value="--include-constant" />
                  <arg value="SCM_CREDENTIALS" />
                  <arg value="--include-constant" />
                  <arg value="SCM_SECURITY" />
                  <arg value="--include-function" />
                  <arg value="sendmsg" />
                  <arg value="--include-function" />
                  <arg value="recvmsg" />
                  <arg value="-t" />
                  <arg value="io.mishmash.foreign.posix.linux.x86_64.libc.sys" />
                  <arg value="--header-class-name" />
                  <arg value="SocketH" />
                  <arg value="${headers.path}/sys/socket.h" />
                </exec>
                <!-- fcntl-related headers -->
                <exec executable="${jextract.path}" dir="${project.build.directory}/generated-sources/jextract" failonerror="true">
                  <arg value="-I" />
                  <arg value="/usr/include" />
